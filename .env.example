# --- Aplicação ---
NODE_ENV=development
PORT=3000
# Origens do rotagest-web autorizadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# URL pública do rotagest-web (links de convite e redefinição de senha)
WEB_URL=http://localhost:5173
LOG_LEVEL=info
# true quando atrás de proxy reverso (IP real para rate limit)
TRUST_PROXY=false
# Swagger fica ativo fora de produção; em produção só com true
SWAGGER_ENABLED=false

# --- Banco ---
DATABASE_URL=postgresql://rotagest:rotagest@localhost:5432/rotagest?schema=public

# --- Autenticação ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS). O web e a API devem estar no mesmo site
# (ex.: app.seudominio.com e api.seudominio.com) para o cookie SameSite=Strict.
COOKIE_SECURE=false

# --- Convites e senha ---
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# --- Plataforma ---
DEFAULT_PLAN_CODE=starter
TRIAL_DAYS=14
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# --- Comprovantes ---
# Pasta PRIVADA (fora de qualquer diretório servido). Download só pela API, com tenant e permissão.
STORAGE_DIR=./storage
ATTACHMENT_MAX_MB=10

# --- Seed (opcional) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
