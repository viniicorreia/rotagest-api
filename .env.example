# --- Aplicação ---
NODE_ENV=development
PORT=3000
# Origens do rotagest-web autorizadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# URL pública do rotagest-web (links de convite e redefinição de senha)
WEB_URL=http://localhost:5173
LOG_LEVEL=info
# true quando atrás de proxy reverso (IP real para rate limit)
TRUST_PROXY=false
# Swagger fica ativo fora de produção; em produção só com true
SWAGGER_ENABLED=false

# --- Banco ---
# A API conecta como rotagest_app (sujeito ao RLS, docs/ARCHITECTURE.md §5.7).
DATABASE_URL=postgresql://rotagest_app:rotagest_app@localhost:5432/rotagest?schema=public
# Dono do banco: migrations, seed e `npm run db:app-role`. Não precisa estar no contêiner da API.
DIRECT_DATABASE_URL=postgresql://rotagest:rotagest@localhost:5432/rotagest?schema=public
# Senha que `npm run db:app-role` define para rotagest_app (use a mesma em DATABASE_URL).
APP_DB_PASSWORD=rotagest_app

# --- Autenticação ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS). O web e a API devem estar no mesmo site
# (ex.: app.seudominio.com e api.seudominio.com) para o cookie SameSite=Strict.
COOKIE_SECURE=false

# --- Convites e senha ---
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# --- Plataforma ---
# Valores iniciais; depois valem os definidos em /platform/settings.
DEFAULT_PLAN_CODE=starter
TRIAL_DAYS=14
# Rotina de hora em hora que passa testes vencidos para "em atraso" (há lock no banco para várias réplicas).
JOBS_ENABLED=true
# Gateway de pagamento da assinatura SaaS. Vazio = só ativação administrativa (nada é cobrado).
BILLING_PROVIDER=
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# --- Comprovantes ---
# Pasta PRIVADA (fora de qualquer diretório servido). Download só pela API, com tenant e permissão.
# local (padrão, usa STORAGE_DIR) ou s3 (bucket S3 ou compatível: MinIO, Cloudflare R2...)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
ATTACHMENT_MAX_MB=10
# Obrigatórios com STORAGE_DRIVER=s3. Objetos privados: sem ACL pública nem URL pré-assinada.
S3_BUCKET=
S3_REGION=
# Só para provedores compatíveis (ex.: http://localhost:9000 no MinIO, https://<conta>.r2.cloudflarestorage.com no R2)
S3_ENDPOINT=
# true para MinIO e outros que não aceitam bucket no subdomínio
S3_FORCE_PATH_STYLE=false
# Credenciais pela cadeia padrão da AWS (variáveis abaixo, perfil ou role da instância/ECS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- E-mail ---
# Vazio = e-mails só no log (fora de produção o link aparece no log; em produção, não).
# Ex.: smtps://usuario:senha@smtp.seuprovedor.com:465 (codifique caracteres especiais da senha com %XX)
SMTP_URL=
MAIL_FROM=RotaGest <nao-responda@rotagest.com.br>

# --- Observabilidade ---
# Token Bearer do Prometheus em GET /api/v1/metrics (mín. 16 caracteres). Vazio = endpoint desativado (404).
METRICS_TOKEN=

# --- Seed (opcional) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
